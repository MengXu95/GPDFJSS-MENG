library(ggplot2)
working_dir <- "/home/xume/IdeaProjects/GPJSS-master"
setwd(working_dir)
sprintf("------------------------Start------------------------------")
result.df <- data.frame(jobID = integer(),
operationID = integer(),
machineID = integer(),
startTime = double(),
completeTime = double(),
transportTime = double()
)
testfile <- paste0("schedule.968356.max-flowtime.0.85.results.csv")
result.df <- read.csv(paste0(testfile), header = TRUE)
# par(pin = c(10,5))
pdf('scheduling.pdf', width=12,height=3)
plot(1:5,1:5,xlim = c(-50,750), ylim = c(-0.5,5.5), type = "n", cex.axis = 1, font.axis = 1, yaxt = "n", ann = FALSE)
par(mai=c(0,1.7,0,0)) #下，左，上，右留白
for(pross in 1:6){
pross <- pross - 1
rect(xleft = 0, ybottom = pross-0.32, xright = 750, ytop = pross+0.32, lwd = 1, lty = 2)
}
color <- c("#FBDD85", "#80A6E2" , "#F46F43", "#ADDB88")
c <- color[1]
for(pos in 1:nrow(result.df)){
row <- result.df[pos,]
txt <- paste0(row$jobID, ".", row$operationID)
index <- row$jobID + 1
c <- color[index]
# if(row$jobID == 0){
#   c <- color[1]
# }
# else{
#   c <- color[2]
# }
rect(xleft = row$startTime, ybottom = row$machineID-0.32, xright = row$completeTime, ytop = row$machineID+0.32, col = c, lwd = 1)
text((row$startTime+row$completeTime)/2, row$machineID+0.01, txt, cex = 0.6)
}
axis(side = 2, at = c(0, 1, 2, 3, 4, 5), labels = paste(c("Machine 0","Machine 1", "Machine 2", "Machine 3", "Machine 4","Machine 5")), las =2, cex.axis = 0.8, xpd = TRUE)
title(xlab= 'Time', cex.lab = 2)
sprintf("------------------------Schedule End!------------------------------")
View(row)
View(result.df)
View(result.df)
