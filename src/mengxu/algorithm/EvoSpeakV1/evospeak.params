# EvoSpeakV1: run EvoSpeakMain.main() with no arguments from the repository root.
evalthreads = 1
breedthreads = 1
seed.0 = 0
checkpoint = false
checkpoint-modulo = 1
checkpoint-prefix = ec
state = mengxu.algorithm.EvoSpeakV1.EvoSpeakEvolutionState
init = ec.gp.GPInitializer
finish = ec.simple.SimpleFinisher
exch = ec.simple.SimpleExchanger
breed = ec.simple.SimpleBreeder
eval = mengxu.algorithm.EvoSpeakV1.EvoSpeakEvaluator
stat = ec.simple.SimpleStatistics
stat.file = $out.stat
stat.do-generation = true
stat.do-message = true
generations = 51
quit-on-run-complete = false
pop = ec.Population
pop.subpops = 1
pop.subpop.0 = ec.Subpopulation
pop.subpop.0.size = 100
pop.subpop.0.species = ec.gp.GPSpecies
pop.subpop.0.species.ind = ec.gp.GPIndividual
pop.subpop.0.species.ind.numtrees = 2
pop.subpop.0.species.ind.tree.0 = ec.gp.GPTree
pop.subpop.0.species.ind.tree.0.tc = tc0
pop.subpop.0.species.ind.tree.1 = ec.gp.GPTree
pop.subpop.0.species.ind.tree.1.tc = tc1
pop.subpop.0.species.fitness = mengxu.algorithm.EvoSpeakV1.WeightedFitness
pop.subpop.0.species.fitness.num-objectives = 2
pop.subpop.0.species.fitness.maximize = false
pop.subpop.0.duplicate-retries = 100
breed.elite.0 = 2
breed.reevaluate-elites.0 = true
pop.subpop.0.species.pipe = ec.breed.MultiBreedingPipeline
pop.subpop.0.species.pipe.generate-max = false
pop.subpop.0.species.pipe.num-sources = 3
pop.subpop.0.species.pipe.source.0 = yimei.jss.algorithm.multipletreegp.AllIndexAllSwapCrossoverPipeline
pop.subpop.0.species.pipe.source.0.prob = 0.8
pop.subpop.0.species.pipe.source.1 = ec.gp.koza.MutationPipeline
pop.subpop.0.species.pipe.source.1.prob = 0.15
pop.subpop.0.species.pipe.source.2 = ec.breed.ReproductionPipeline
pop.subpop.0.species.pipe.source.2.prob = 0.05
breed.reproduce.source.0 = ec.select.TournamentSelection
gp.koza.xover.source.0 = ec.select.TournamentSelection
gp.koza.xover.source.1 = same
gp.koza.xover.ns.0 = ec.gp.koza.KozaNodeSelector
gp.koza.xover.ns.1 = same
gp.koza.xover.maxdepth = 8
gp.koza.xover.tries = 1
gp.koza.mutate.source.0 = ec.select.TournamentSelection
gp.koza.mutate.ns.0 = ec.gp.koza.KozaNodeSelector
gp.koza.mutate.build.0 = ec.gp.koza.GrowBuilder
gp.koza.mutate.maxdepth = 8
gp.koza.mutate.tries = 1
select.tournament.size = 4
gp.koza.grow.min-depth = 4
gp.koza.grow.max-depth = 4
gp.koza.ns.terminals = 0.1
gp.koza.ns.nonterminals = 0.9
gp.koza.ns.root = 0.0
gp.type.a.size = 1
gp.type.a.0.name = nil
gp.type.s.size = 0
gp.tc.size = 2
gp.tc.0 = ec.gp.GPTreeConstraints
gp.tc.0.name = tc0
gp.tc.0.fset = f0
gp.tc.0.returns = nil
gp.tc.0.init = ec.gp.koza.HalfBuilder
gp.tc.1 = ec.gp.GPTreeConstraints
gp.tc.1.name = tc1
gp.tc.1.fset = f0
gp.tc.1.returns = nil
gp.tc.1.init = ec.gp.koza.HalfBuilder
gp.koza.half.min-depth = 2
gp.koza.half.max-depth = 6
gp.koza.half.growp = 0.5
gp.nc.size = 3
gp.nc.0 = ec.gp.GPNodeConstraints
gp.nc.0.name = nc0
gp.nc.0.returns = nil
gp.nc.0.size = 0
gp.nc.1 = ec.gp.GPNodeConstraints
gp.nc.1.name = nc1
gp.nc.1.returns = nil
gp.nc.1.size = 1
gp.nc.1.child.0 = nil
gp.nc.2 = ec.gp.GPNodeConstraints
gp.nc.2.name = nc2
gp.nc.2.returns = nil
gp.nc.2.size = 2
gp.nc.2.child.0 = nil
gp.nc.2.child.1 = nil
gp.problem.stack = ec.gp.ADFStack
gp.adf-stack.context = ec.gp.ADFContext
gp.fs.size = 1
gp.fs.0.name = f0
gp.fs.0.size = 7
gp.fs.0.func.0 = yimei.jss.gp.terminal.TerminalERCUniform
gp.fs.0.func.0.nc = nc0
gp.fs.0.func.1 = yimei.jss.gp.function.Add
gp.fs.0.func.1.nc = nc2
gp.fs.0.func.2 = yimei.jss.gp.function.Sub
gp.fs.0.func.2.nc = nc2
gp.fs.0.func.3 = yimei.jss.gp.function.Mul
gp.fs.0.func.3.nc = nc2
gp.fs.0.func.4 = yimei.jss.gp.function.Div
gp.fs.0.func.4.nc = nc2
gp.fs.0.func.5 = yimei.jss.gp.function.Max
gp.fs.0.func.5.nc = nc2
gp.fs.0.func.6 = yimei.jss.gp.function.Min
gp.fs.0.func.6.nc = nc2
eval.problem = yimei.jss.ruleoptimisation.MultipleTreeRuleOptimizationProblem
eval.problem.data = yimei.jss.gp.data.DoubleData
eval.problem.eval-model = mengxu.complexsimulation.ruleevaluation.MultipleTreeMultipleRuleHeterogeneousEvaluationModel
eval.problem.eval-model.objectives = 2
eval.problem.eval-model.objectives.0 = mean-flowtime
eval.problem.eval-model.objectives.1 = mean-weighted-tardiness
eval.problem.eval-model.sim-models = 1
eval.problem.eval-model.sim-models.0.num-machines = 10
eval.problem.eval-model.sim-models.0.min-num-operations = 1
eval.problem.eval-model.sim-models.0.max-num-operations = 10
eval.problem.eval-model.sim-models.0.util-level = 0.85
eval.problem.eval-model.sim-models.0.due-date-factor = 1.5
eval.problem.eval-model.sim-models.0.num-jobs = 5000
eval.problem.eval-model.sim-models.0.warmup-jobs = 1000
eval.problem.eval-model.sim-models.0.replications = 1
eval.problem.eval-model.rotate-sim-seed = true
terminals-from = relative
num-trees = 2

# single or multi (weighted sum, not NSGA-II). Weights are normalized to sum to one.
evospeak.objective-mode = multi
evospeak.objective.0 = mean-flowtime
evospeak.objective.1 = mean-weighted-tardiness
evospeak.weight.0 = 0.5
evospeak.weight.1 = 0.5
evospeak.normalization = true
# llm or file. Relative paths below are relative to this params file.
evospeak.source = llm
evospeak.population-file = ../EvoSpeak/WarmStart/population_100_0.5_MO.txt
evospeak.output-directory = runs
evospeak.batch-size = 10
evospeak.max-batches = 40
evospeak.max-tree-depth = 8
evospeak.max-tree-nodes = 255
evospeak.validation.jobs = 500
evospeak.validation.warmup = 100
evospeak.validation.seeds = 17001,17002
evospeak.validation.timeout-seconds = 20
evospeak.validation.max-decisions = 1000000
# Optional extra generation instructions: evospeak.prompt-file = generation-prompt.txt

# openai-compatible, azure-openai, anthropic, or ollama.
# A full endpoint URL can override the provider default; no secrets in this file.
llm.provider = openai-compatible
llm.model = gpt-4.1-mini
llm.api-key-env = OPENAI_API_KEY
llm.timeout-seconds = 120
llm.max-output-tokens = 8000
llm.max-attempts = 3
# Optional: llm.endpoint = https://api.openai.com/v1/chat/completions
# Azure: full https://.../openai/deployments/.../chat/completions?api-version=... URL.
# Optional: llm.temperature = 0.7 (omit for models without temperature support).
# Optional: llm.token-parameter = max_completion_tokens (OpenAI-compatible only).

# Independent RuleAnalysisMain; --population and --prompt-file can override these.
analysis.language = Chinese
analysis.prompt = Explain both trees, their interaction, terminal meanings, signs, branches and limitations. Do not claim measured superiority.
analysis.max-individuals = 100