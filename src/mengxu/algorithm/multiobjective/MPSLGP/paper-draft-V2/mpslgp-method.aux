\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces \textcolor {red}{Test performance under matched group-level population budgets: mean(std) of HV, IGD and GD over all 30 runs. Each method uses a total population allocation of 1,000 per group and 50 evaluated generations. Bounds and reference fronts are common within this comparison and are recomputed independently of Table~\ref {tab:latest-main-quality}. At baseline entries, $(\uparrow )$, $(\downarrow )$ and $(=)$ denote MPSLGP's significant advantage, disadvantage and nonsignificant difference under the unadjusted paired Wilcoxon test at $\alpha =0.05$. Bold identifies the best unrounded mean. Higher HV and lower IGD/GD are preferable. The 76 invalid PSLGP preference outcomes are excluded; all seeds are retained.}}}{13}{table.7}\protected@file@percent }
\newlabel{tab:same-budget-quality}{{VII}{13}{\mm {Test performance under matched group-level population budgets: mean(std) of HV, IGD and GD over all 30 runs. Each method uses a total population allocation of 1,000 per group and 50 evaluated generations. Bounds and reference fronts are common within this comparison and are recomputed independently of Table~\ref {tab:latest-main-quality}. At baseline entries, $(\uparrow )$, $(\downarrow )$ and $(=)$ denote MPSLGP's significant advantage, disadvantage and nonsignificant difference under the unadjusted paired Wilcoxon test at $\alpha =0.05$. Bold identifies the best unrounded mean. Higher HV and lower IGD/GD are preferable. The 76 invalid PSLGP preference outcomes are excluded; all seeds are retained.}}{table.7}{}}
